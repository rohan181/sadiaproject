configfile: "config.yaml"

rule all:
    input:
        "work/validated.done",
        "work/access.parquet",
        "work/spatial_statistics.parquet",
        "work/district_statistics.parquet",
        "../public/data/analysis/manifest.json",
        "../public/data/observed/district-population-2025.json",
        "../public/data/observed/subdistrict-population-2025.json"

rule aggregate_observed_population:
    input:
        population=config["population_raster"],
        districts=config["districts_file"],
        subdistricts=config["subdistricts_file"]
    output:
        districts="../public/data/observed/district-population-2025.json",
        subdistricts="../public/data/observed/subdistrict-population-2025.json"
    shell:
        "python scripts/aggregate_population.py --raster {input.population} "
        "--districts {input.districts} --subdistricts {input.subdistricts} "
        "--output-dir ../public/data/observed"

rule validate_inputs:
    input:
        facilities=config["facilities_file"],
        population=config["population_raster"],
        roads=config["roads_file"],
        districts=config["districts_file"],
        subdistricts=config["subdistricts_file"]
    output: "work/validated.done"
    shell: "python scripts/validate_inputs.py --config config.yaml --output {output}"

rule calculate_access:
    input: "work/routing.done"
    output: "work/access.parquet"
    shell: "python scripts/calculate_access.py --config config.yaml --output {output}"

rule filter_roads_pbf:
    input: config["roads_file"]
    output: "work/roads_filtered.osm.pbf"
    shell:
        "osmium tags-filter {input} "
        "w/highway=motorway,motorway_link,trunk,trunk_link,primary,primary_link,secondary,secondary_link,"
        "tertiary,tertiary_link,unclassified,residential,living_street "
        "-o {output} --overwrite"

rule load_roads:
    input:
        pbf="work/roads_filtered.osm.pbf",
        validated="work/validated.done"
    output: "work/roads_loaded.done"
    shell: "python scripts/load_roads.py --config config.yaml --roads-pbf {input.pbf} --output {output}"

rule load_facilities_and_origins:
    input:
        roads="work/roads_loaded.done",
        subdistrict_population="../public/data/observed/subdistrict-population-2025.json"
    output: "work/facilities_loaded.done"
    shell: "python scripts/load_facilities_and_origins.py --config config.yaml --output {output}"

rule route_access:
    input:
        roads="work/roads_loaded.done",
        facilities="work/facilities_loaded.done"
    output: "work/routing.done"
    shell: "python scripts/route_access.py --config config.yaml --sql sql/002_route_access.sql --output {output}"

rule spatial_statistics:
    input: "work/access.parquet"
    output:
        upazila="work/spatial_statistics.parquet",
        district="work/district_statistics.parquet"
    shell:
        "python scripts/spatial_statistics.py --input {input} "
        "--upazila-output {output.upazila} --district-output {output.district}"

rule export_dashboard:
    input:
        upazila="work/spatial_statistics.parquet",
        district="work/district_statistics.parquet"
    output: "../public/data/analysis/manifest.json"
    shell:
        "python scripts/export_dashboard.py --upazila-input {input.upazila} "
        "--district-input {input.district} --output {output}"
